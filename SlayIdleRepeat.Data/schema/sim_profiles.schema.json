{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slayidlerepeat.local/schema/sim_profiles.schema.json",
  "title": "sim_profiles.json",
  "description": "21 §5.4, §5.4.1-5.4.3 — the 14 behavioural profiles the economy simulator runs every time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "_doc", "_status", "adPlacementGroups", "profiles"],
  "$defs": {
    "rate01": { "type": "number", "minimum": 0, "maximum": 1 },
    "nullableRate01": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  },
  "properties": {
    "$schema": { "type": "string" },
    "_doc": { "type": "string", "minLength": 1 },
    "_status": { "enum": ["transcribed", "partial", "skeleton"] },
    "adPlacementGroups": {
      "description": "21 §5.4.3 — the 29 placements of 12 §4 partitioned into three watch-propensity groups. Every placement in 12 §4 must appear in exactly one group; a placement in none or in two is a bug.",
      "type": "object",
      "additionalProperties": false,
      "required": ["HIGH", "MEDIUM", "LOW"],
      "properties": {
        "HIGH": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^AD_[A-Z0-9_]+$" } },
        "MEDIUM": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^AD_[A-Z0-9_]+$" } },
        "LOW": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^AD_[A-Z0-9_]+$" } }
      }
    },
    "profiles": {
      "description": "21 §5.4 — profiles may be added freely; the 14 in the design doc are the minimum set the assertions in 21 §11 require.",
      "type": "array",
      "minItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cadence", "competence", "plus", "features", "ads"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "seedBand": {
            "description": "21 §5.4 — Unlucky_Core is seeded to the p10 RNG band (E1). Absent means the ordinary seed band.",
            "enum": ["p10", "p50", "p90"]
          },
          "cadence": {
            "description": "21 §5 — a player's real constraint is time, not appetite (§5.1). lapseProbability stacks on top of daysPerWeekActive: a rest day is not a lapse.",
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionsPerDay", "minutesPerSession", "daysPerWeekActive", "lapseProbability", "maxLapseDays"],
            "properties": {
              "sessionsPerDay": { "type": "number", "minimum": 1, "maximum": 6 },
              "minutesPerSession": { "type": "number", "exclusiveMinimum": 0 },
              "daysPerWeekActive": { "type": "integer", "minimum": 1, "maximum": 7 },
              "lapseProbability": { "$ref": "#/$defs/rate01" },
              "maxLapseDays": { "type": "integer", "minimum": 0, "maximum": 30 }
            }
          },
          "competence": {
            "description": "21 §5 — skillFactor scales effective power in combat; systemLiteracy degrades the decision policy toward random by that fraction.",
            "type": "object",
            "additionalProperties": false,
            "required": ["skillFactor", "systemLiteracy"],
            "properties": {
              "skillFactor": { "type": "number", "minimum": 0.7, "maximum": 1.3 },
              "systemLiteracy": { "$ref": "#/$defs/rate01" }
            }
          },
          "plus": {
            "description": "21 §5.3 — Plus is modelled by setting the entitlement and issuing the same ClaimAdReward commands. plusStartDay/plusEndDay model lapse so A15 can check a lapsed subscriber never regresses. -1 means never.",
            "type": "object",
            "additionalProperties": false,
            "required": ["hasPlus", "plusStartDay", "plusEndDay"],
            "properties": {
              "hasPlus": { "type": "boolean" },
              "plusStartDay": { "type": "integer", "minimum": -1, "maximum": 180 },
              "plusEndDay": { "type": "integer", "minimum": -1, "maximum": 180 }
            }
          },
          "features": {
            "description": "21 §5.2 — runs, dungeons, events and pvp are normalised to sum to 1.0 and allocate the session-minute budget. The rest are independent participation rates.",
            "type": "object",
            "additionalProperties": false,
            "required": ["runs", "dungeons", "events", "pvp", "guildActivity", "dailyQuests", "luckyWheel", "loginCalendar", "forgeDiligence", "focusUsage", "autoSalvage"],
            "properties": {
              "runs": { "$ref": "#/$defs/rate01" },
              "dungeons": { "$ref": "#/$defs/rate01" },
              "events": { "$ref": "#/$defs/rate01" },
              "pvp": { "$ref": "#/$defs/rate01" },
              "guildActivity": { "$ref": "#/$defs/rate01" },
              "dailyQuests": { "$ref": "#/$defs/rate01" },
              "luckyWheel": { "$ref": "#/$defs/rate01" },
              "loginCalendar": { "$ref": "#/$defs/rate01" },
              "forgeDiligence": { "$ref": "#/$defs/rate01" },
              "focusUsage": { "$ref": "#/$defs/rate01" },
              "autoSalvage": { "$ref": "#/$defs/rate01" }
            }
          },
          "ads": {
            "description": "21 §5.3 — per placement, not a single rate: the placements differ enormously in power-per-ad and the 45% fairness gap is entirely a function of which ones players actually watch. null rates mean Plus auto-grant (no ad is watched).",
            "type": "object",
            "additionalProperties": false,
            "required": ["defaultWatchRate", "groupWatchRates", "interstitialTolerance"],
            "properties": {
              "defaultWatchRate": { "$ref": "#/$defs/nullableRate01" },
              "groupWatchRates": {
                "type": "object",
                "additionalProperties": false,
                "required": ["HIGH", "MEDIUM", "LOW"],
                "properties": {
                  "HIGH": { "$ref": "#/$defs/nullableRate01" },
                  "MEDIUM": { "$ref": "#/$defs/nullableRate01" },
                  "LOW": { "$ref": "#/$defs/nullableRate01" }
                }
              },
              "interstitialTolerance": { "$ref": "#/$defs/rate01" }
            }
          }
        }
      }
    }
  }
}
