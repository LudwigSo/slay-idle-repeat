# Skill run state (handover files, kickoff records) — not deliverables
.claude/.feature-runs/
.claude/.milestone-runs/

# Agent worktrees — nested git worktrees, never part of the tree they sit in
.claude/worktrees/

# Godot import cache — never committed
.godot/
mono_crash.*.json

# Local compose overrides (M0-03). `.env.example` IS committed and documents
# every knob; `.env` is one developer's port numbers and never belongs in the
# tree. docker-compose.yml works with no .env present.
.env
docker-compose.override.yml

# ----------------------------------------------------------------- .NET build
[Bb]in/
[Oo]bj/
artifacts/
*.binlog

# ------------------------------------------------------------------- test run
[Tt]est[Rr]esults/
*.trx
*.coverage
coverage*.json
coverage*.xml
coverage*.info

# ReportGenerator's output directory for the CRAP score
# (scripts/Measure-Crap.ps1). Regenerated in full by every run; the patterns above
# only cover coverage FILES, not this directory. TestResults/ - where coverlet
# writes the raw OpenCover XML the report is built from - is already covered by
# the [Tt]est[Rr]esults/ rule above.
coverage/

# Stryker.NET mutation reports (README.md). Regenerated in full by every run.
StrykerOutput/

# SonarScanner for .NET's working directory (build/ci/Invoke-SonarAnalysis.ps1).
# Written by `begin`, consumed by `end`, and it holds the analysis config the
# scanner downloaded from the server - which includes the token it was given.
# Never committed.
.sonarqube/

# --------------------------------------------------------------------- NuGet
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets

# ------------------------------------------------------------- IDE / tooling
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs
.DS_Store

# --- M0-05a / O23 Android export spike (spikes/godot-android-export) ---
# The Godot Android build template is unpacked into <project>/android/ by
# `--install-android-build-template`. It is ~1260 MB of vendored engine source
# plus Gradle output — measured, not estimated, by the O23 Android export
# spike — and is fully regenerable, so
# it is never committed. The number matters beyond this file: M7-10 sizes runner
# disk from whichever figure it reads, and the "~200 MB" that used to be here was
# out by a factor of six.
# If a task ever needs to hand-edit android/build/build.gradle (e.g. injecting
# the AppLovin MAX AARs), that edit must be committed as a patch or a script
# instead.
spikes/**/android/

# --- M7-01 / the real Godot client (src/SlayIdleRepeat.Client) ---
# The same Android build template as above, in the project that actually ships it.
# Regenerable, ~1260 MB, and the Godot SDK globs every .cs beneath the project
# directory — hence the matching <Compile Remove> block in the .csproj.
src/SlayIdleRepeat.Client/android/
# The game-data mirror. res://data/ is a copy of game-data/ produced at build time
# so an exported build can read content without walking up to the solution file.
# Generated, never authored: edit game-data/ instead.
src/SlayIdleRepeat.Client/data/

# --- M0-05b / O23 iOS export spike (spikes/godot-ios-export) ---
# The iOS export destination is chosen in export_presets.cfg and deliberately
# points OUTSIDE the Godot project, at artifacts/ios/ — which is already covered
# by the artifacts/ rule above. That is the mitigation for the iOS twin of the
# Android leg's failure 6, so please do not "simplify" it by exporting into the
# project directory.
# The patterns below only exist so a stray hand-run export cannot be committed.

# Exported binaries and .NET build output inside spikes.
spikes/**/bin/
spikes/**/obj/
*.apk
*.aab
*.ipa
*.xcarchive/
*.xcodeproj/
*.xcworkspace/

# Blender writes a .blend1 backup beside every save. The .blend is the source; the
# backup is a local undo step and never part of the tree.
*.blend1

# The asset build scripts are imported into Blender, which caches bytecode beside them.
assets/source/__pycache__/
