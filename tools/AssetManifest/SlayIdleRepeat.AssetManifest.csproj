<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The asset-manifest register (M8-09): a typed reader over game-data/assets/*.json, plus the
    reconciliation rules that hold BETWEEN the manifest and the counts 15 §E1 and 20 §4 claim.

    It sits under tools/ beside BalanceHarness, ContentValidator and EconomySim because it ships
    to nobody: the manifest is a production-pipeline register, consumed by M8-01a (provenance
    keyed to asset id), M8-06 (delivery size / pivot / atlas drive post-processing) and M8-10
    (one placeholder per slot). No game rule reads it.

    🔒 A LIBRARY, and a dependency-free one. It project-references nothing — in particular no
    SlayIdleRepeat.Adapters.*, which ProjectFileTests.Only_composition_roots_reference_adapter_projects
    forbids outside a composition root, and tools/ is in that rule's scope. It package-references
    nothing either: System.Text.Json is in-box on net8.0, so this adds no row to
    Directory.Packages.props and no row to build/ci/non-vendor-packages.json.
  -->

  <PropertyGroup>
    <RootNamespace>SlayIdleRepeat.AssetManifest</RootNamespace>
    <AssemblyName>SlayIdleRepeat.AssetManifest</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
