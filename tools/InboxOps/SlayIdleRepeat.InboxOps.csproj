<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The inbox operations tool (28 Part A): targeting, the mandatory segment dry run, and the
    audit log.

    🔒 A CONSOLE APP, NOT AN ADMIN ENDPOINT, and that is the whole security argument: there is no
    admin authentication anywhere in this repository, so an HTTP surface that could send 500 Soul
    Shards to a predicate would be an unauthenticated economy-affecting endpoint. A tool run from a
    terminal is reached by whoever can reach the database, which is the access control that already
    exists.

    It is a composition root in 23 §7's sense — it wires Adapters.Persistence.Postgres and
    Adapters.Content.LocalFile to the inbox services in Application — and is named as one in
    ProductionAssemblies.ToolCompositionRootNames, beside ContentValidator.

    It sits under tools/ rather than src/ because it ships to nobody.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SlayIdleRepeat.InboxOps</RootNamespace>
    <AssemblyName>SlayIdleRepeat.InboxOps</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SlayIdleRepeat.Application\SlayIdleRepeat.Application.csproj" />
    <ProjectReference Include="..\..\src\adapters\shared\SlayIdleRepeat.Adapters.Content.LocalFile\SlayIdleRepeat.Adapters.Content.LocalFile.csproj" />
    <ProjectReference Include="..\..\src\adapters\server\SlayIdleRepeat.Adapters.Persistence.Postgres\SlayIdleRepeat.Adapters.Persistence.Postgres.csproj" />
    <ProjectReference Include="..\..\src\adapters\shared\SlayIdleRepeat.Adapters.Ambient.System\SlayIdleRepeat.Adapters.Ambient.System.csproj" />
  </ItemGroup>

</Project>
