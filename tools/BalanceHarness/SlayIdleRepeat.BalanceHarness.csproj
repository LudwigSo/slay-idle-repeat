<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Restated from Directory.Build.props, which already says net8.0 for every project and
    remains the one place the version is decided. Stryker.NET 4.16 needs the property on the
    .csproj itself: read only from Directory.Build.props, its Buildalyzer pass returns an empty
    result and the run dies with "Analyzing 0 projects" before a single mutant is created.
    The CLI target-framework option does not substitute. Core, Core.Tests and BalanceHarness
    carry it for that reason alone: the mutated project, its test project, and that test
    project's other ProjectReference. Do NOT change the value here; change Directory.Build.props.
  -->
  <PropertyGroup><TargetFramework>net8.0</TargetFramework></PropertyGroup>

  <!--
    Mass battle simulation over SlayIdleRepeat.Core (05 §9).

    🔒 References SlayIdleRepeat.Core ONLY, and NO PackageReference at all —
    ProjectFileTests.The_simulation_tools_reference_Core_only fails the build on either
    (30 §6, 21 §2). No Application, no adapters, no I/O ports: the whole game is playable
    from Core alone.

    M2-16a: Content/GameDataLoader.cs — game-data/*.json -> ContentSnapshot, so the
    harness can build a boss encounter from the authored file. System.Text.Json,
    System.IO and System.Security.Cryptography only, all of which are in the shared
    framework, so the Core-only pin above still holds byte for byte.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SlayIdleRepeat.Core\SlayIdleRepeat.Core.csproj" />
  </ItemGroup>

</Project>
