<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Godot is an adapter, not a foundation (23 §5 A10): audio, haptics, locale,
    device info, filesystem paths.

    A plain SDK project rather than a Godot SDK one: nothing here derives from a
    Node or needs the script source generators, so all it wants is the managed
    engine API. This is the ONE project repo-wide allowed to name GodotSharp —
    the version lives in Directory.Packages.props.
  -->

  <ItemGroup>
    <PackageReference Include="GodotSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SlayIdleRepeat.Application\SlayIdleRepeat.Application.csproj" />
  </ItemGroup>

</Project>
