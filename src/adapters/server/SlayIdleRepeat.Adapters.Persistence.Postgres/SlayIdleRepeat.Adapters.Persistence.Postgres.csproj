<Project Sdk="Microsoft.NET.Sdk">

  <!--
    IPlayerRepository / IGhostRepository / … over PostgreSQL.
    Npgsql is referenced by this project and no other (23 §5 A9).
  -->

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <!-- The migration history rides inside the assembly: the runner applies what this build IS,
       never whatever files happen to sit beside the deployed binary. -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SlayIdleRepeat.Application\SlayIdleRepeat.Application.csproj" />
  </ItemGroup>

</Project>
