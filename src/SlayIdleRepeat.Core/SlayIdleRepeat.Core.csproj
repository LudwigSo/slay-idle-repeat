<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Restated from Directory.Build.props, which already says net8.0 for every project and
    remains the one place the version is decided. Stryker.NET 4.16 needs the property on the
    .csproj itself: read only from Directory.Build.props, its Buildalyzer pass returns an empty
    result and the run dies with "Analyzing 0 projects" before a single mutant is created.
    The CLI target-framework option does not substitute. Core, Core.Tests and BalanceHarness
    carry it for that reason alone: the mutated project, its test project, and that test
    project's other ProjectReference. Do NOT change the value here; change Directory.Build.props.
  -->
  <PropertyGroup><TargetFramework>net8.0</TargetFramework></PropertyGroup>

  <!--
    SlayIdleRepeat.Core — THE WHOLE GAME. Zero dependencies (23 §6, 30 §11).

    This project references NOTHING: no ProjectReference, no PackageReference,
    not even a logging abstraction. The whole game must be playable from this
    assembly alone (30 §6 InMemoryGame), and its assembly closure must stay
    exactly { SlayIdleRepeat.Core, System.* }.

    InternalsVisibleTo is permitted for SlayIdleRepeat.Core.Tests ONLY (30 §11.3).
  -->

  <!--
    The one sanctioned opening (30 §11.3): handlers and rule calculators are internal by
    design, so the domain test suite is the only assembly that can drive them directly.
    InternalsVisibleTo_names_only_the_Core_test_assembly asserts nothing else appears here.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="SlayIdleRepeat.Core.Tests" />
  </ItemGroup>

</Project>
