; Engine configuration for the Slay. Idle. Repeat. client.
;
; Hand-written, and it stays hand-written: the editor rewrites this file the
; moment it saves, so anything added here without a reason next to it is the
; first thing a later editor session silently reorders or drops. Every setting
; below either the engine refuses to start without, or the Android export
; refuses to run without, or is a product decision with its reason next to it.
;
; ⚠️ The Android export ITSELF is not configured here — there is no
; export_presets.cfg and no build in this task. That is the export task's.

config_version=5

[application]

config/name="Slay. Idle. Repeat."
config/description="Roll. Fight. Merge. Repeat."
; ⚠️ The SECOND home of the assembly version, and the one the store reads: the
; export writes this into versionName. Directory.Build.props' <Version> is the
; first, and nothing enforces that the two agree — keep them in step by hand.
config/version="0.1.0"
run/main_scene="res://game/scenes/AppRoot.tscn"
; Not decoration: the engine logs "No project icon specified." and the export
; treats a missing icon as a configuration error. icon.svg is a project file,
; not artwork — see the comment inside it.
config/icon="res://icon.svg"
; Off, and that is a decision rather than a default: left alone the engine draws
; its own logo as the first thing on screen, so an exported build would open on
; another project's branding. Declining it is not the same as designing a
; splash — the splash screen, and whatever image eventually goes here, belong to
; the boot task and to art that does not exist yet. Until then the background
; colour stands, which shows no more than a blank frame but claims nothing.
boot_splash/show_image=false
; The designing half of the decision above, and written out rather than left to
; the engine's default: this is the very first thing on screen, drawn before any
; scene exists, and Boot.tscn paints the same colour. Together with
; default_clear_color below it makes one continuous ground from the window
; opening to our first drawn frame — a different value here is a visible flash
; of somebody else's grey at the exact moment a player is judging the launch.
boot_splash/bg_color=Color(0.07, 0.07, 0.09, 1)
; 4.7 — M0-05a pinned the engine at 4.7.1-stable, and both spike projects say
; "4.7". config/features is what the editor reads to decide whether a project
; needs an upgrade pass, so a stale "4.4" here would make the first person to
; open this run a version conversion nobody asked for. It is the only Godot
; version string under src/.
config/features=PackedStringArray("4.7", "C#", "Mobile")

[display]

; 1080x1920 design canvas, portrait only, supported from 9:16 to 9:20.
window/size/viewport_width=1080
window/size/viewport_height=1920
; Desktop only, and the reason the game is playable on this machine at all: the
; canvas is taller than any laptop screen, so an unscaled window opens off the
; bottom of the display. Ignored on a handset.
window/size/window_width_override=540
window/size/window_height_override=960
; 1 = portrait. Locked rather than sensor-driven — this is a one-handed portrait
; game and there is no landscape layout to rotate into.
window/handheld/orientation=1
; canvas_items scales the UI with the canvas instead of the framebuffer, so text
; stays sharp at any device resolution. "expand" rather than "keep": across
; 9:16 to 9:20 the extra room appears as height, which is what safe-area padding
; is there to absorb — "keep" would spend it on black bars instead.
;
; 🔒 It is also what makes the 3D basis and the UI overlay cost each other
; nothing, which was not true of the alternative. canvas_items scales the CANVAS
; transform and leaves the root viewport at the window's own size, so the 3D
; world renders at the device's real resolution while the overlay is laid out in
; 1080x1920 canvas units. "viewport" mode would have rendered both through one
; 1080x1920 framebuffer — soft 3D on a 1440p handset, and upscaled text with it.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="SlayIdleRepeat.Client"

[android]

package/unique_name="de.ludwigso.slayidlerepeat"

[ios]

application/bundle_identifier="de.ludwigso.slayidlerepeat"

[rendering]

; The mobile renderer, on every platform including the desktop one this is
; developed on — a desktop-only forward+ preview would flatter the look of a
; build no player gets.
;
; ⚠️ It is now carrying 3D, which it was not when this line was written. The
; mobile renderer draws 3D on every target this game ships to, but it is the
; renderer that DROPS features rather than degrading them — no SDFGI, no SSAO,
; no SSR, no volumetric fog, and one directional shadow map. Nothing in this
; build uses any of those, and nothing may start to: a 3D screen authored
; against a forward+ editor preview is a screen no player sees.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; ⚠️ Mandatory. Without it the Android export refuses outright: "ETC2/ASTC
; texture compression is required for Android export." The iOS exporter checks
; the same setting.
textures/vram_compression/import_etc2_astc=true
; The last of the FOUR grounds, and the one that covers the gap: the engine's
; splash colour is shown until the first scene draws, AppRoot.tscn's
; WorldEnvironment paints the 3D background from the first composed frame on,
; each screen's own Ground plane sits in front of that, and this is what shows
; anywhere none of them does. All four are the same colour on purpose — the goal
; is that nothing flashes, not that four settings each look reasonable alone.
;
; 🔴 This one is no longer only a fallback. Under the mobile renderer the clear
; colour is what a viewport with no current Camera3D shows, and this build has
; exactly one moment like that: between the root composing and the boot screen's
; _Ready claiming the viewport. A different value here is a visible flash at the
; same instant the old 2D build had none.
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.09, 1)
