; The action column, under the thumb. Every control in it is 340 tall, which is this screen
; family's own height and well above the 144-pixel floor.
[node name="ActionColumn" type="VBoxContainer" parent="Ui/Screen/SafeArea/Column"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 24

; 🔴 Aiming and hitting share ONE row, and that is what makes reduced motion cost no height at all.
; Stacked, the extra control a player who asked for nothing to move is given took a third 340 out
; of a frame that has 1920 of them, and the bar they were aiming at was squeezed under the fold —
; the setting meant to help would have been the setting that made the game unplayable. Side by side
; both halves span the width and neither sits in a corner, so the pair reads the same to either
; hand. The row collapses with the strike when the arm is not the timing bar.
[node name="StrikeRow" type="HBoxContainer" parent="Ui/Screen/SafeArea/Column/ActionColumn"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 24

; Drawn only for a player who asked for nothing to move. It is not a lesser control: the cursor
; does not sweep at all under reduced motion, so this is the whole of how that player aims. It sits
; before the strike because that is the order it is used in — move the marker, then hit it.
[node name="StepButton" type="Button" parent="Ui/Screen/SafeArea/Column/ActionColumn/StrikeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 340)
layout_mode = 2
visible = false
size_flags_horizontal = 3
theme_type_variation = &"QuietButton"
theme_override_font_sizes/font_size = 60
autowrap_mode = 3

[node name="StrikeButton" type="Button" parent="Ui/Screen/SafeArea/Column/ActionColumn/StrikeRow"]
unique_name_in_owner = true
