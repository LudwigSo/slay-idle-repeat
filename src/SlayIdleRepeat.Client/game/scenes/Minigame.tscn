layout_mode = 2
visible = false
size_flags_horizontal = 3
theme_type_variation = &"PrimaryButton"
theme_override_font_sizes/font_size = 80
autowrap_mode = 3

[node name="RollButton" type="Button" parent="Ui/Screen/SafeArea/Column/ActionColumn"]
unique_name_in_owner = true
