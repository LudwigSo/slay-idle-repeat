; -------------------------------------------------------------------------------- the sheet
;
; Everything from here down is drawn OVER the bands: the scrim, the item sheet and the confirmation.
; All three start hidden. The scrim is a flat Button so a tap beside the sheet closes it; the sheet
; rises from the bottom edge to about 62 % of the canvas, leaving the hero and the slot columns
; visible above it, which is the point of a bottom sheet over a full modal.
[node name="Scrim" type="Button" parent="Ui/Screen"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"GearScrim"
