; S16 — the Gear screen. Two halves, as the brief draws them: the hero with the six slots around it
; above, the bag below, and the Forge's operations in a sheet that rises over both. Every number the
; screen draws is InventoryPresenter's; this file states where things sit and which theme variation
; each wears, and its script forwards presses.
;
; Four bands, two of which flex. The top bar and the tab dock are pinned to Home's heights so the
; chrome does not jump between the two screens the tab bar connects; the hero band and the deck share
; what is left at 0.9 : 1.1 — the hero is drawn SMALL, as asked, and the bag is what the player came
; to work on. At 9:16 that is roughly 690 and 840; at 9:20 both grow.
[node name="Inventory" type="Node3D"]
script = ExtResource("1_inventory")

[node name="World" type="Node3D" parent="."]
unique_name_in_owner = true

[node name="Camera" type="Camera3D" parent="World"]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 6)
fov = 60.0

[node name="Ground" type="MeshInstance3D" parent="World"]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -6)
mesh = SubResource("QuadMesh_ground")
material_override = SubResource("StandardMaterial3D_ground")

; This screen's framing of the hero, and this screen's alone — Hero.tscn keeps its model at identity
; for exactly this reason. Less than half of Home's 1.32, turned the same 22 degrees toward the key light,
; and lifted so the whole figure sits in the upper band between the two slot columns — head under
; the top bar, feet above the deck's edge at 9:16. The camera does not move.
[node name="Hero" parent="World" instance=ExtResource("2_hero")]
unique_name_in_owner = true
transform = Transform3D(0.5563, 0, -0.2248, 0, 0.6, 0, 0.2248, 0, 0.5563, 0, 0.5, 0)

[node name="Ui" type="CanvasLayer" parent="."]
unique_name_in_owner = true

; 🔴 mouse_filter = 2 on the overlay root, for the reason Home.tscn records at length: a Control
; anchored to the whole viewport defaults to STOP and would swallow every tap the bands did not take.
[node name="Screen" type="Control" parent="Ui"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("3_theme")

[node name="Bands" type="VBoxContainer" parent="Ui/Screen"]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 0

