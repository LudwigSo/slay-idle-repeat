; ------------------------------------------------------------------------- the confirmation
;
; Centred rather than a sheet, because it is the one irreversible decision on the screen and a
; centred modal is what the genre reserves for those. It lists what the batch pays and what in it a
; player might regret, and the red button answers. Sized by its content — no fixed height — so a
; batch with nothing to warn about gets a short card and one with three warnings a taller one.
[node name="Confirm" type="PanelContainer" parent="Ui/Screen"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -480.0
offset_right = 480.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"GearModal"

[node name="ConfirmColumn" type="VBoxContainer" parent="Ui/Screen/Confirm"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 18

