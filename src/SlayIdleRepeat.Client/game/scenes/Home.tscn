; Home's framing of the hero, and Home's alone: scale 1.32, a 22-degree turn toward the light and
; a drop of 2.0 so the diorama sits in the lower half of the portrait frame, below the tile band
; the HUD now puts across the upper half. It used to be baked into Hero.tscn's Model, where every
; other screen had to cancel it (see BoardWorld's history).
[node name="Hero" parent="World" instance=ExtResource("2_hero")]
unique_name_in_owner = true
transform = Transform3D(1.22388, 0, -0.49449, 0, 1.32, 0, 0.49449, 0, 1.22388, 0, -2, 0)

[node name="Ui" type="CanvasLayer" parent="."]
unique_name_in_owner = true

; The shared theme is assigned once, here, on the root of the overlay: every control below inherits
; it, and each names a type variation rather than carrying colours and sizes of its own.
[node name="Screen" type="Control" parent="Ui"]
