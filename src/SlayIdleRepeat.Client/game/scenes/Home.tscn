; Home's framing of the hero, and Home's alone: scale 1.32, a 22-degree turn toward the light and
; a drop of 1.1 so the diorama sits inside the hero band, between the top bar and the launch block
; the run hub now puts across the bottom third. It used to be baked into Hero.tscn's Model, where
; every other screen had to cancel it (see BoardWorld's history).
[node name="Hero" parent="World" instance=ExtResource("2_hero")]
unique_name_in_owner = true
transform = Transform3D(1.22388, 0, -0.49449, 0, 1.32, 0, 0.49449, 0, 1.22388, 0, -1.1, 0)

[node name="Ui" type="CanvasLayer" parent="."]
unique_name_in_owner = true

; The shared theme is assigned once, here, on the root of the overlay: every control below inherits
; it, and each names a type variation rather than carrying colours and sizes of its own.
;
; 🔴 mouse_filter = 2 (Ignore), and it is the one property this whole overlay could not do without.
; A Control defaults to STOP, and this one is anchored to the entire viewport underneath every band —
; so without this line it SWALLOWS every pointer event on the screen that no control above it took,
; and the mouse_filter = 2 set on Bands, TopBar, HeroBand and NameBlock buys exactly nothing. It was
; latent rather than live only because nothing on this screen listens for an unhandled input yet; the
; next thing that does would have been debugged against a scene that silently ate its events.
; HomeSceneRuleTests pins it, because there is nothing about a missing property that reads as wrong.
[node name="Screen" type="Control" parent="Ui"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("3_theme")

; The four bands, stacked with no separation. Three are pinned to their exported heights and the
; hero band expands into whatever is left, which is HomeLayout's one rule expressed in containers —
; the layout is what states it in numbers a test can read.
[node name="Bands" type="VBoxContainer" parent="Ui/Screen"]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 0

; ------------------------------------------------------------------------------- the top bar
;
; The top safe inset lands inside this band: the margin below grows and the row moves down with it,
; so nothing is ever drawn under a notch and the band still paints behind the status bar.
[node name="TopBar" type="MarginContainer" parent="Ui/Screen/Bands"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 192)
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 0
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 0

[node name="Row" type="HBoxContainer" parent="Ui/Screen/Bands/TopBar"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 18

; HudTile's 36-unit side padding made this tile as wide as the Legend Level written in it — 113 at
; two digits and 134 at three — so the avatar quietly took width HomeLayout had budgeted to the
; pills. HubAvatar pads it by 12, which leaves four digits inside the 108 the layout charges for,
; and rounds it as the reference draws it: a square with an 11/36 corner, not the circle a 72
; radius clamps to on a 108 box.
[node name="Avatar" type="PanelContainer" parent="Ui/Screen/Bands/TopBar/Row"]
custom_minimum_size = Vector2(108, 108)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"HubAvatar"

[node name="AvatarLevel" type="Label" parent="Ui/Screen/Bands/TopBar/Row/Avatar"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"HudCaption"
horizontal_alignment = 1
vertical_alignment = 1
text_overrun_behavior = 3

[node name="CrownsPill" parent="Ui/Screen/Bands/TopBar/Row" instance=ExtResource("5_pill")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
Glyph = 2

[node name="EnergyPill" parent="Ui/Screen/Bands/TopBar/Row" instance=ExtResource("5_pill")]
