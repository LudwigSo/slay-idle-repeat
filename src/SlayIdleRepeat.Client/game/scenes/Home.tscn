; The settings control takes the bar's slack itself and stays its own size inside it — EXPAND for
; the leftover width, SHRINK_END to sit at the far end of it, which is the reference's
; margin-left:auto. A spacer node between the pills and this one would be a SIXTH item in the row
; and so a FIFTH gap, and HomeLayout charges the bar for four: at the longest values that one
; uncounted 18 put the row three units over the width the pills were promised.
;
; ⚠️ ChromeButton rather than QuietButton, and the reason is arithmetic rather than taste: this
; control is drawn as a 144 target and captioned 'Settings', and QuietButton's 48-unit font inside
; 80 units of padding makes that word 291 wide — 147 units taken straight out of the pill row with
; nothing anywhere to say so. ChromeButton fits the caption inside the target the layout measured.
[node name="SettingsButton" type="Button" parent="Ui/Screen/Bands/TopBar/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(144, 144)
layout_mode = 2
size_flags_horizontal = 10
size_flags_vertical = 4
theme_type_variation = &"ChromeButton"
text_overrun_behavior = 3

