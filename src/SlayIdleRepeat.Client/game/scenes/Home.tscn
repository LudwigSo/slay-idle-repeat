visible = false
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 42.0
offset_top = -318.0
offset_right = -42.0
offset_bottom = -186.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_type_variation = &"HeroSubtitle"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

