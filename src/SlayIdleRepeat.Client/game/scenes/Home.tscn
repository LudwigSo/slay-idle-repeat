; The tile band: two columns of 468 with a 16 gutter is the 952 the safe area leaves of a 1080
; canvas. Each tile stops the pointer so a long press on it reaches Home.cs; the icon and the
; containers inside it ignore the pointer so the press lands on the tile rather than on a child.
[node name="Tiles" type="GridContainer" parent="Ui/Screen/SafeArea/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16
