; 🔒 These two are the only labels on the screen with nothing of the theme's behind them: what is
; behind them is the diorama, whose brightness is the hero's and the ground's. HeroTitle and
; HeroSubtitle are HudTitle and HudCaption with the theme's darkest ink drawn round the glyphs,
; which is the one contrast a flat font colour cannot give over a picture. The reference solves the
; same problem with a vignette; an outline needs no node and cannot bleed onto the diorama.
;
; ⚠️ Both trim with an ellipsis, exactly as the stage card's two lines do, and for the same reason
; twice over: the first line is a PLAYER-SUPPLIED display name and the second is a localised
; sentence, and this block is positioned by anchors inside a band of fixed height. A Label with no
; trimming reports its whole text as its minimum width, so a long name would push this container
; wider than the canvas and draw the name off both edges rather than shortening it.
[node name="HeroName" type="Label" parent="Ui/Screen/Bands/HeroBand/NameBlock"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"HeroTitle"
horizontal_alignment = 1
text_overrun_behavior = 3

[node name="HeroCaption" type="Label" parent="Ui/Screen/Bands/HeroBand/NameBlock"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"HeroSubtitle"
horizontal_alignment = 1
text_overrun_behavior = 3

