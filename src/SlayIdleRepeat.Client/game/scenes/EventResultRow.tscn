[gd_scene format=3]

; One line of what a resolved event card moved: the caption on the left, the signed amount on the
; right. Authored here rather than built in code, like RunEndCounterRow and InventoryDeltaRow, so
; the two halves can be given their own colours and their own alignment — a caption and a number
; glued into one label with two spaces cannot line up down a column.
;
; Sizes and colours are per-node rather than named off SlayTheme, exactly as its two sibling row
; scenes are: this scene is instantiated into a screen and only inherits that screen's theme once it
; is in the tree, so a row drawn from a theme it turned out not to inherit would be silently
; unreadable rather than merely wrong.
[node name="EventResultRow" type="HBoxContainer"]
theme_override_constants/separation = 24

[node name="CaptionLabel" type="Label" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 1
theme_override_colors/font_color = Color(0.66, 0.67, 0.73, 1)
theme_override_font_sizes/font_size = 44
vertical_alignment = 1
autowrap_mode = 3

; 144 square because it is the surface a long press is read off, and it wraps rather than trims: the
; hold exists to show the exact figure, and a figure that trims is not shown.
[node name="ValueLabel" type="Label" parent="."]
custom_minimum_size = Vector2(144, 144)
layout_mode = 2
mouse_filter = 0
theme_override_colors/font_color = Color(0.93, 0.93, 0.96, 1)
theme_override_font_sizes/font_size = 44
vertical_alignment = 1
horizontal_alignment = 2
autowrap_mode = 3
