[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://game/scenes/Enemy.cs" id="1_enemy"]

; The template every catalogue model is instanced under. The models ship facing +Z, the way glTF
; faces, and an actor rig looks along its own -Z, so ModelYawDegrees turns the model round to look
; the way its rig does. Model is the placeholder Dress replaces; it holds nothing of its own.
[node name="Enemy" type="Node3D"]
script = ExtResource("1_enemy")
ModelYawDegrees = 180.0

[node name="Model" type="Node3D" parent="."]
