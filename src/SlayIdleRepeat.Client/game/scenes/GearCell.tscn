[gd_scene format=3]

; One item in the bag grid, and one candidate on the merge page: a square tap target carrying the
; slot's glyph, the band's gem, the +N, and one mark in each free corner — lock or worn bottom-left,
; better-than-worn top-right — plus the selection tick that covers the glyph in select mode.
;
; 🔒 A Button whose children all ignore the pointer, drawn through the theme's GearCell face; the
; band is written on at render time as a tint and a corner shape over duplicates of that face. Five
; of these fit the deck's 1024 at 184 with 26 between them — 61 dp a cell, above the 48 dp floor with
; room for two badges each, and 8 dp of air between neighbours so a thumb does not open the one beside.
;
; The corner map is fixed so marks never collide: gem top-left, upgrade top-right, lock-or-worn
; bottom-left, +N bottom-right. A cell that is worn AND locked shows the lock: the worn fact is on
; the slot tile above, the lock fact is nowhere else.
[node name="GearCell" type="Button"]
custom_minimum_size = Vector2(184, 184)
theme_type_variation = &"GearCell"
text_overrun_behavior = 3

[node name="Glyph" type="TextureRect" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -46.0
offset_top = -46.0
offset_right = 46.0
offset_bottom = 46.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

