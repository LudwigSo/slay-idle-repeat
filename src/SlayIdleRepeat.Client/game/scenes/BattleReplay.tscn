[node name="World" type="Node3D" parent="."]
unique_name_in_owner = true
script = ExtResource("2_world")

; The rig's yaw and the pitch's tilt are written again by the rig on _Ready, and its position and
; the camera's distance on Snap — so these govern only the first frame. But the first frame is
; what a screenshot of a scene file shows, and a rig that failed to wire would leave the stage
; drawn from here forever. Kept in step with the rig's own exports.
[node name="CameraRig" type="Node3D" parent="World"]
unique_name_in_owner = true
transform = Transform3D(0.8829, 0, 0.4695, 0, 1, 0, -0.4695, 0, 0.8829, 0, 1.2, 0)
script = ExtResource("3_rig")
YawDegrees = -28.0
PitchDegrees = 16.0
Margin = 1.15
UsableBandTop = 0.14
UsableBandBottom = 0.7
HalfLife = 0.35

[node name="Pitch" type="Node3D" parent="World/CameraRig"]
transform = Transform3D(1, 0, 0, 0, 0.9613, -0.2756, 0, 0.2756, 0.9613, 0, 0, 0)

; 🔒 A bare Camera3D named Camera, unique_in_owner, fov 60 — ScreenStage.Show resolves "%Camera"
; and calls MakeCurrent on it, which is the whole handover contract and is orthogonal to every
; transform the rig writes. Put the rig's script on this node instead and every handover in the
; build draws through the previous screen's camera, silently.
[node name="Camera" type="Camera3D" parent="World/CameraRig/Pitch"]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 12)
fov = 60.0

