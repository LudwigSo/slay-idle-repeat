<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The asset-manifest register's suite (M8-09).

    Discovered automatically into the `unit` group by build/ci/Invoke-UnitTests.ps1's
    tests/*/*.csproj glob — no edit to build/ci/test-suites.json, and REQUIRED to contain tests
    from day one, which is why it ships populated rather than seeded empty.

    It reads the real game-data/assets/*.json. That is not an integration test: the manifest is a
    committed text file in this repository, the same way SlayIdleRepeat.Application.Tests reads the
    real game-data. Nothing here needs Docker, a server, a database or the Godot runtime.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Provides the "XPlat code coverage" collector coverage.runsettings names; see docs/crap.md. -->
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\AssetManifest\SlayIdleRepeat.AssetManifest.csproj" />
  </ItemGroup>

  <!--
    Shared test vocabulary, linked rather than project-referenced — tests/Shared/ holds no .csproj
    because the discovery glob would find it and fail it as a permanently empty suite.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
