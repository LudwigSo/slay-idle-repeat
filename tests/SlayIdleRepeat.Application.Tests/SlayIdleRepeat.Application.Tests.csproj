<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Use-case tests. Every content case runs against SlayIdleRepeat.Adapters.InMemory
    exclusively — no real adapter, no container, no network (23 §8).

    The one exception is the 📐 tunable audit, which is a build-time audit of a
    repository rather than a runtime read of content: it enumerates game-design/*.md,
    which never ships. Its composition therefore lives in tools/ContentValidator, and
    this project references that tool so the guarding test runs the SAME wiring CI runs.
    Re-assembling it here would leave the tool's doc glob, its governsTuningFile
    derivation and its baseline path unexercised, with the test still green.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SlayIdleRepeat.Application\SlayIdleRepeat.Application.csproj" />
    <ProjectReference Include="..\..\src\adapters\fakes\SlayIdleRepeat.Adapters.InMemory\SlayIdleRepeat.Adapters.InMemory.csproj" />
    <ProjectReference Include="..\..\tools\ContentValidator\SlayIdleRepeat.ContentValidator.csproj" />
  </ItemGroup>

</Project>
