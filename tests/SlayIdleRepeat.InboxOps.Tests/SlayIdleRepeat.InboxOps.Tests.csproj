<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The inbox operations tool's suite (M5-08).

    Discovered automatically into the `unit` group by build/ci/Invoke-UnitTests.ps1's
    tests/*/*.csproj glob — no edit to build/ci/test-suites.json, and REQUIRED to contain tests
    from day one, which is why it ships populated rather than seeded empty.

    🔒 It exercises the tool's ARGUMENT LAYER and nothing else. Every refusal that decides whether
    an economy-affecting send is well formed lives in InboxOpsArguments, which is a pure transform
    over a string[] — no database, no network, no content set. The tool's I/O half is a composition
    root, and a check that only runs when a live Postgres is reachable is a check nobody can
    exercise here.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\InboxOps\SlayIdleRepeat.InboxOps.csproj" />
  </ItemGroup>

  <!--
    Shared test vocabulary, linked rather than project-referenced — tests/Shared/ holds no .csproj
    because the discovery glob would find it and fail it as a permanently empty suite.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
