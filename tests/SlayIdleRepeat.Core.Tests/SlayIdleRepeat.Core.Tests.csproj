<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The domain test suite. It is the assembly Core grants InternalsVisibleTo (30 §11.3),
    and the only assembly it grants it to.

    It references SlayIdleRepeat.Core and — since M2-16a — tools/BalanceHarness, which is
    itself pinned to Core with no packages, so the closure is unchanged. See the reference
    itself for why the loader is consumed rather than restated.

    Seeded empty by M0-01, and no longer empty: 799 tests as of the M0 review,
    covering Rng (M0-06), CanonicalStateWriter and the 14 §16.6 field-order pin
    (M0-07) and the Content value tree (M0-09). The rest arrive with their
    milestones.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Provides the "XPlat code coverage" collector coverage.runsettings names; see docs/crap.md. -->
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SlayIdleRepeat.Core\SlayIdleRepeat.Core.csproj" />

    <!--
      🔒 tools/BalanceHarness, for its GameDataLoader ONLY — the game-data/*.json ->
      ContentSnapshot composition BossCatalogue is read through here.

      The precedent is SlayIdleRepeat.Application.Tests, which project-references
      tools/ContentValidator for exactly this reason: the composition lives in a tool that
      ships, so the suite CONSUMES it rather than restating it. Re-assembling the loader in
      this tree would leave the shipped one — the one 05 §9's harness actually runs — untested,
      with every case here still green.

      ⚠️ This does NOT widen what this suite may reach. BalanceHarness is itself pinned to
      SlayIdleRepeat.Core with no packages (ProjectFileTests.The_simulation_tools_reference_
      Core_only), so the transitive closure is Core plus the shared framework — the same closure
      the header above describes. It replaces the EmbeddedResource that reached into
      ../../game-data/ for bosses.json, which inverted the convention EnemyFixtures and
      StatFixtures both state.
    -->
    <ProjectReference Include="..\..\tools\BalanceHarness\SlayIdleRepeat.BalanceHarness.csproj" />
  </ItemGroup>

  <!--
    Shared test vocabulary, linked rather than project-referenced. tests/Shared/ holds no
    .csproj on purpose: build/ci/test-suites.json discovers suites with the glob
    tests/*/*.csproj and fails any it finds containing zero tests, so a helper project here
    would be a permanently red empty suite. See tests/Shared/WildcardMessageAssertions.cs.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    The Hash64 / DeterministicRng determinism pin (14 §8.0, §8.2). Embedded rather than
    copied to the output directory so the cross-platform determinism job (M5-12) finds it
    on Android/iOS ARM64 regardless of the working directory the runner happens to use.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Rng\Hash64ReferenceVectors.json" />
  </ItemGroup>

  <!--
    The CanonicalStateWriter determinism pin (14 §16.6) and the field-order pin it is
    keyed to, embedded for the same reason as the file above: M5-12 re-asserts both on
    Android/iOS ARM64, where the working directory is not ours to predict.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Model\Snapshots\CanonicalStateWriterReferenceVectors.json" />
    <EmbeddedResource Include="Model\Snapshots\SnapshotFieldOrder.json" />
  </ItemGroup>

  <!--
    The battle LogHash determinism pin (05 §7), embedded for the same reason as the two
    above: M5-12 re-asserts it on Android/iOS ARM64, and 11 §6 depends on the client and
    the server agreeing on these bytes.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Rules\Combat\CombatLogReferenceVectors.json" />
  </ItemGroup>

  <!--
    M2-17's 18 §8 determinism baseline over 10 000 seeded build permutations, embedded for the same
    reason as the three above: M5-12 re-asserts it off-host.

    🔴 It is NOT a reference-vector table in M0-06's or M0-07's sense. Those were validated against
    externally published vectors; "build permutation -> hash" has no publisher, so this table is
    self-generated and proves STABILITY, not correctness. The file's own $comment header says so, and
    DslDeterminismBaselineTests asserts that it still does.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Rules\Effects\Determinism\DslDeterminismBaseline.json" />
  </ItemGroup>

  <!--
    🔴 M2-13's EmbeddedResource for ..\..\game-data\content\bosses\bosses.json was DELETED by
    M2-16a, together with the test-side System.Text.Json reader (AuthoredBossScripts) it fed.

    It was the only EmbeddedResource here that reached into game-data/, and it existed because
    this suite had no way to read a path: the boss cases are about the SHIPPED script satisfying
    BossEncounterBuilder's eight authoring rules, which a restated fixture cannot show. The
    successor is SlayIdleRepeat.Core.Rules.Combat.Bosses.BossCatalogue on EnemyCatalogue's
    precedent, read through the BalanceHarness GameDataLoader referenced above — so the cases
    still assert the shipped file, off disk, with no second mapping of it in this tree.
  -->

</Project>
