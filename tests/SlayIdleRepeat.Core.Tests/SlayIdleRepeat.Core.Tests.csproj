<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Restated from Directory.Build.props, which already says net8.0 for every project and
    remains the one place the version is decided. Stryker.NET 4.16 needs the property on the
    .csproj itself: read only from Directory.Build.props, its Buildalyzer pass returns an empty
    result and the run dies with "Analyzing 0 projects" before a single mutant is created.
    The CLI target-framework option does not substitute. Core and Core.Tests carry it for that
    reason alone: the mutated project and its test project. Do NOT change the value here;
    change Directory.Build.props.
  -->
  <PropertyGroup><TargetFramework>net8.0</TargetFramework></PropertyGroup>

  <!--
    The domain test suite. It is the assembly Core grants InternalsVisibleTo (30 §11.3),
    and the only assembly it grants it to.

    It references SlayIdleRepeat.Core and nothing else, so its closure is Core plus the shared
    framework. The game-data -> ContentSnapshot loader it reads the shipped content through
    lives in TestSupport/GameDataLoader.cs.

    Seeded empty by M0-01, and no longer empty: 799 tests as of the M0 review,
    covering Rng (M0-06), CanonicalStateWriter and the 14 §16.6 field-order pin
    (M0-07) and the Content value tree (M0-09). The rest arrive with their
    milestones.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Provides the "XPlat code coverage" collector coverage.runsettings names. -->
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SlayIdleRepeat.Core\SlayIdleRepeat.Core.csproj" />
  </ItemGroup>

  <!--
    The Hash64 / DeterministicRng determinism pin (14 §8.0, §8.2). Embedded rather than
    copied to the output directory so the cross-platform determinism job finds it on
    Android ARM64 regardless of the working directory the runner happens to use. The job's
    live legs are Linux x64 and Android ARM64; the iOS ARM64 leg is authored and gated off
    with iOS itself (16 D34).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Rng\Hash64ReferenceVectors.json" />
  </ItemGroup>

  <!--
    The CanonicalStateWriter determinism pin (14 §16.6) and the field-order pin it is
    keyed to, embedded for the same reason as the file above: the determinism job re-asserts
    both on Android ARM64, where the working directory is not ours to predict.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Model\Snapshots\CanonicalStateWriterReferenceVectors.json" />
    <EmbeddedResource Include="Model\Snapshots\SnapshotFieldOrder.json" />
  </ItemGroup>

  <!--
    The battle LogHash encoding pin (05 §7), embedded for the same reason as the two above:
    the determinism job re-asserts it on Android ARM64, and 11 §6 depends on the client and
    the server agreeing on these bytes.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Rules\Combat\CombatLogReferenceVectors.json" />
  </ItemGroup>

  <!--
    M2-17's 18 §8 determinism baseline over 10 000 seeded build permutations, embedded for the same
    reason as the three above: M5-12 re-asserts it off-host.

    🔴 It is NOT a reference-vector table in M0-06's or M0-07's sense. Those were validated against
    externally published vectors; "build permutation -> hash" has no publisher, so this table is
    self-generated and proves STABILITY, not correctness. The file's own $comment header says so, and
    DslDeterminismBaselineTests asserts that it still does.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Rules\Effects\Determinism\DslDeterminismBaseline.json" />
  </ItemGroup>

  <!--
    🔴 M2-13's EmbeddedResource for ..\..\game-data\content\bosses\bosses.json was DELETED by
    M2-16a, together with the test-side System.Text.Json reader (AuthoredBossScripts) it fed.

    It was the only EmbeddedResource here that reached into game-data/, and it existed because
    this suite had no way to read a path: the boss cases are about the SHIPPED script satisfying
    BossEncounterBuilder's eight authoring rules, which a restated fixture cannot show. The
    successor is SlayIdleRepeat.Core.Rules.Combat.Bosses.BossCatalogue on EnemyCatalogue's
    precedent, read through TestSupport/GameDataLoader.cs — so the cases still assert the
    shipped file, off disk, with no second mapping of it in this tree.
  -->

</Project>
