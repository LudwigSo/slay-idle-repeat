<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Enforces 23 §6 and 30 §9. Fails the build on violation.

    It reflects over EVERY production assembly, which is why it — uniquely among
    the test projects — references all of them.

    M0-08 authors the rules; M0-01 only seeds the project.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      Every rule in this suite must name the doc section it enforces, and
      SuiteIntegrityTests reads those XML summaries back at run time to prove it
      (acceptance criterion 4 of M0-08). That only works if the compiler emits
      the doc file, and with TreatWarningsAsErrors the CS1591 that comes with it
      turns "a rule with no citation" into a build error rather than a habit.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!--
      🔒 Shouldly (BSD-3-Clause), the assertion library for all four test suites. M1-00
      swapped it in for FluentAssertions, whose v8 moved to a paid commercial licence — a
      version pin at 7.2.0 was the only thing holding this repo back from it. Do not
      reintroduce FluentAssertions. Version lives in Directory.Packages.props.

      ⚠️ Referenced but NOT USED here today, and that was equally true of FluentAssertions.
      The rules in this suite assert through NetArchTest's own fluent API — whose
      `ShouldNot()` is NetArchTest's, not Shouldly's — plus a couple of bare `Assert` calls.
      It is kept so a new rule can assert like every other suite in the repo without a
      packaging decision first, and because build/ci/non-vendor-packages.json allow-lists it
      on the basis that it is in four projects. Remove it here only together with that entry.
    -->
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NetArchTest.Rules" />
    <!--
      Mono.Cecil arrives transitively with NetArchTest; named explicitly because
      this suite scans IL directly for the rules NetArchTest cannot express
      (field writes, banned member references, async state machines).
    -->
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>

