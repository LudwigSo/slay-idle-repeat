{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slayidlerepeat.local/schema/luck.schema.json",
  "title": "luck.json",
  "description": "24 — every pity N, soft-pity slope and source-class map. 24 §3: adding a new grant source must assign it a class; the validator fails the build if a grant source has no class.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "_doc", "_status", "sourceClasses", "chestStandard", "chestPremium", "chestApex", "dropRun", "eggPet", "crateMount", "enhance", "draft", "wheel", "minigame", "boardAndEncounterVariance", "focus", "setTokens", "reforge", "retune"],
  "$defs": {
    "rarity": { "enum": ["C", "B", "A", "S", "SS"] },
    "hardPityStep": {
      "description": "24 §1 M1 — on reaching everyNth, the next draw is forced to satisfy the guarantee and the counter resets to 0. M1 is mandatory everywhere.",
      "type": "object",
      "additionalProperties": false,
      "required": ["everyNth", "guaranteeRarityAtLeast"],
      "properties": {
        "everyNth": { "type": "integer", "minimum": 1 },
        "guaranteeRarityAtLeast": { "$ref": "#/$defs/rarity" }
      }
    },
    "softPity": {
      "description": "24 §1 M2 — after missThreshold misses, the target's weight is multiplied by 1 + slope * (misses - missThreshold). null means this class has no soft pity. The threshold must sit below the hard-pity N it protects.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["target", "missThreshold", "slope"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "missThreshold": { "type": "integer", "minimum": 0 },
        "slope": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "rarityCostMap": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": { "^(C|B|A|S|SS)$": { "type": ["integer", "null"], "minimum": 0 } }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "_doc": { "type": "string", "minLength": 1 },
    "_status": { "enum": ["transcribed", "partial", "skeleton"] },
    "sourceClasses": {
      "description": "24 §3 — the closed set of source classes. Every grant source in the game must map to exactly one of these; counterKey is null when the counter is not player-scoped.",
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "counterKey", "counterScope"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "counterKey": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9.]*$" },
          "counterScope": { "enum": ["PLAYER", "GEAR_INSTANCE", "RUN"] }
        }
      }
    },
    "chestStandard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "hardPity", "softPity"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "hardPity": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hardPityStep" } },
        "softPity": { "$ref": "#/$defs/softPity" }
      }
    },
    "chestPremium": { "$ref": "#/properties/chestStandard" },
    "chestApex": { "$ref": "#/properties/chestStandard" },
    "dropRun": {
      "description": "24 §4.3 — the dry-streak breaker.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "eliteMercy", "bossMercy", "sessionFloor"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "eliteMercy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consecutiveMissesBeforeForce", "belowRarity", "forceRarityAtLeast"],
          "properties": {
            "consecutiveMissesBeforeForce": { "type": "integer", "minimum": 1 },
            "belowRarity": { "$ref": "#/$defs/rarity" },
            "forceRarityAtLeast": { "$ref": "#/$defs/rarity" }
          }
        },
        "bossMercy": { "$ref": "#/properties/dropRun/properties/eliteMercy" },
        "sessionFloor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grantRarity", "grantCount", "maxPerDay", "requiresVictoryOrStage3Death"],
          "properties": {
            "grantRarity": { "$ref": "#/$defs/rarity" },
            "grantCount": { "type": "integer", "minimum": 1 },
            "maxPerDay": { "type": "integer", "minimum": 1 },
            "requiresVictoryOrStage3Death": { "type": "boolean" }
          }
        }
      }
    },
    "eggPet": {
      "description": "24 §4.4 — supersedes 07 §2.2.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "hardPity", "softPity", "duplicateProtectionOnPity", "newcomerFloorDistinctPets", "beastMarkPerDuplicateAtMaxStar", "beastMarkExchange"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "hardPity": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hardPityStep" } },
        "softPity": { "$ref": "#/$defs/softPity" },
        "duplicateProtectionOnPity": { "type": "boolean" },
        "newcomerFloorDistinctPets": { "type": "integer", "minimum": 0 },
        "beastMarkPerDuplicateAtMaxStar": { "type": "integer", "minimum": 0 },
        "beastMarkExchange": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["marks", "grantRarityAnyOf"],
            "properties": {
              "marks": { "type": "integer", "minimum": 1 },
              "grantRarityAnyOf": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/rarity" } }
            }
          }
        }
      }
    },
    "crateMount": {
      "description": "24 §4.5 — new in 24; mounts were previously unprotected.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "odds", "hardPity", "softPity", "duplicateProtectionOnPity", "duplicateBeastFeed", "duplicateBeastMarks"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "odds": {
          "description": "24 §4.5 — percentages; must sum to 100.",
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "S", "SS"],
          "patternProperties": { "^(A|S|SS)$": { "type": "number", "minimum": 0, "maximum": 100 } }
        },
        "hardPity": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hardPityStep" } },
        "softPity": { "$ref": "#/$defs/softPity" },
        "duplicateProtectionOnPity": { "type": "boolean" },
        "duplicateBeastFeed": { "type": "integer", "minimum": 0 },
        "duplicateBeastMarks": { "type": "integer", "minimum": 0 }
      }
    },
    "enhance": {
      "description": "24 §4.6 — failure mercy, supersedes 08 §4.2. The counter lives on the gear instance and is inherited by merge outputs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "mercySlopePerConsecutiveFailure", "effectiveRateCap", "adEnhanceLuckStacksAdditively", "adEnhanceLuckAdvancesCounter"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "mercySlopePerConsecutiveFailure": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "effectiveRateCap": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "adEnhanceLuckStacksAdditively": { "type": "boolean" },
        "adEnhanceLuckAdvancesCounter": {
          "description": "12 §4.2 / 24 §2 — no ad placement may advance, reset or protect a pity counter. This must be false.",
          "const": false
        }
      }
    },
    "draft": {
      "description": "24 §4.7 — supersedes 06 §4.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "legendaryPityDraftNumber", "qualityFloor", "codexBias", "upgradeFamine"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "legendaryPityDraftNumber": { "type": "integer", "minimum": 1 },
        "qualityFloor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consecutiveDraftsWithoutAboveCommon", "forceRarityAtLeast"],
          "properties": {
            "consecutiveDraftsWithoutAboveCommon": { "type": "integer", "minimum": 1 },
            "forceRarityAtLeast": { "enum": ["COMMON", "RARE", "EPIC", "LEGENDARY"] }
          }
        },
        "codexBias": {
          "type": "object",
          "additionalProperties": false,
          "required": ["neverDraftedWeightMultiplier", "maxBiasSelectedOptions"],
          "properties": {
            "neverDraftedWeightMultiplier": { "type": "number", "minimum": 1 },
            "maxBiasSelectedOptions": { "type": "integer", "minimum": 0, "maximum": 3 }
          }
        },
        "upgradeFamine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ownedUpgradeBias", "consecutiveDraftsWithoutOwnedUpgrade"],
          "properties": {
            "ownedUpgradeBias": { "type": "number", "minimum": 0, "maximum": 1 },
            "consecutiveDraftsWithoutOwnedUpgrade": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "wheel": {
      "description": "24 §4.8 — supersedes 19 Part F. 24 §4.8 is the authority.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "jackpotHardPitySpins", "softPity", "noTripleRepeat"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "jackpotHardPitySpins": { "type": "integer", "minimum": 1 },
        "softPity": { "$ref": "#/$defs/softPity" },
        "noTripleRepeat": { "type": "boolean" }
      }
    },
    "minigame": {
      "description": "24 §4.9 — MG_CHEST_PICK only. The other three minigames are skill-scaled and carry no counter.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "chestPick"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "chestPick": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chestCount", "goldTierChests", "guaranteeAfterConsecutiveMisses"],
          "properties": {
            "chestCount": { "type": "integer", "minimum": 2 },
            "goldTierChests": { "type": "integer", "minimum": 1 },
            "guaranteeAfterConsecutiveMisses": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "boardAndEncounterVariance": {
      "description": "24 §4.10 — the variance floors that keep a run from being empty.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "minTreasureTilesPerRun", "minCacheTilesPerRun", "noRepeatEliteModifierConsecutive", "pvpCandidatesBelowPlayerMin", "pvpCandidateCount", "noWorstEventOutcomeTwiceConsecutive"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "minTreasureTilesPerRun": { "type": "integer", "minimum": 0 },
        "minCacheTilesPerRun": { "type": "integer", "minimum": 0 },
        "noRepeatEliteModifierConsecutive": { "type": "boolean" },
        "pvpCandidatesBelowPlayerMin": { "type": "integer", "minimum": 0 },
        "pvpCandidateCount": { "type": "integer", "minimum": 1 },
        "noWorstEventOutcomeTwiceConsecutive": { "type": "boolean" }
      }
    },
    "focus": {
      "description": "24 §5 — targeted acquisition. Free, one slot + one family, and deliberately scoped to gear classes only: it does not apply to pets or mounts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "weightMultiplier", "changeCooldownHours", "cost", "appliesToClasses"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "weightMultiplier": { "type": "number", "minimum": 1 },
        "changeCooldownHours": { "type": "number", "minimum": 0 },
        "cost": { "const": 0 },
        "appliesToClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
      }
    },
    "setTokens": {
      "description": "24 §5.1 — the SS set endgame (M3). A mercy-accrual counter, deliberately not a wallet currency (10 §1.1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "grantPerSsSalvage", "grantPerSsDuplicate", "costForChosenSsItem"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "grantPerSsSalvage": { "type": "integer", "minimum": 0 },
        "grantPerSsDuplicate": { "type": "integer", "minimum": 0 },
        "costForChosenSsItem": { "type": "integer", "minimum": 1 }
      }
    },
    "reforge": {
      "description": "24 §6.1 — quality re-roll, keep-best. Quality can only go up.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "currency", "costByRarity", "keepBest"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "currency": { "enum": ["MERGE_DUST", "ENHANCE_STONES", "CROWNS", "SOUL_SHARDS", "BEAST_FEED", "HONOR"] },
        "costByRarity": { "$ref": "#/$defs/rarityCostMap" },
        "keepBest": { "const": true }
      }
    },
    "retune": {
      "description": "24 §6.2 — affix re-roll with lockable affixes and a wishlist. No C row: C items roll no affixes (08 §2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "currency", "costByRarity", "lockCostMultiplier", "wishlistMaxAffixes", "wishlistMissWeightBonus"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "currency": { "enum": ["MERGE_DUST", "ENHANCE_STONES", "CROWNS", "SOUL_SHARDS", "BEAST_FEED", "HONOR"] },
        "costByRarity": { "$ref": "#/$defs/rarityCostMap" },
        "lockCostMultiplier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["1", "2", "3"],
          "patternProperties": { "^[123]$": { "type": "number", "minimum": 1 } }
        },
        "wishlistMaxAffixes": { "type": "integer", "minimum": 1, "maximum": 4 },
        "wishlistMissWeightBonus": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  }
}
