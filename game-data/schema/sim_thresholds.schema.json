{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slayidlerepeat.local/schema/sim_thresholds.schema.json",
  "title": "sim_thresholds.json",
  "description": "21 §11 — the CI assertion thresholds themselves, so they are re-tuned deliberately rather than by editing code. 16 named assertions plus 23 inherited requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "_doc", "_status", "run", "coreEconomy", "powerModel", "behaviourAndFairness", "inherited"],
  "$defs": {
    "assertion": {
      "description": "One assertion. _doc is mandatory: an assertion whose threshold nobody can trace back to a design-doc section is a threshold nobody will defend.",
      "type": "object",
      "required": ["_doc"],
      "properties": { "_doc": { "type": "string", "minLength": 1 } }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "_doc": { "type": "string", "minLength": 1 },
    "_status": { "enum": ["transcribed", "partial", "skeleton"] },
    "run": {
      "description": "21 §8.4, §10, §6.1 — simulation extent and the runtime budget. 21 §6.1: if the runtime ever exceeds runtimeBudgetMinutes, cut fidelity, not iterations.",
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "seeds", "fastSeeds", "fastDays", "runtimeBudgetMinutes", "singlePlayerBudgetMs", "reportedPercentiles"],
      "properties": {
        "days": { "type": "integer", "minimum": 1 },
        "seeds": { "type": "integer", "minimum": 1 },
        "fastSeeds": { "type": "integer", "minimum": 1 },
        "fastDays": { "type": "integer", "minimum": 1 },
        "runtimeBudgetMinutes": { "type": "number", "exclusiveMinimum": 0 },
        "singlePlayerBudgetMs": { "type": "number", "exclusiveMinimum": 0 },
        "reportedPercentiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 100 } }
      }
    },
    "coreEconomy": {
      "description": "21 §11.1 — A1 through A9.",
      "type": "object",
      "additionalProperties": false,
      "required": ["A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8", "A9"],
      "properties": {
        "A1": { "$ref": "#/$defs/assertion" },
        "A2": { "$ref": "#/$defs/assertion" },
        "A3": { "$ref": "#/$defs/assertion" },
        "A4": { "$ref": "#/$defs/assertion" },
        "A5": { "$ref": "#/$defs/assertion" },
        "A6": { "$ref": "#/$defs/assertion" },
        "A7": { "$ref": "#/$defs/assertion" },
        "A8": { "$ref": "#/$defs/assertion" },
        "A9": { "$ref": "#/$defs/assertion" }
      }
    },
    "powerModel": {
      "description": "21 §11.2 — A10 through A14, from 29. A14 is the assertion this entire tool exists to evaluate; all others are diagnosis.",
      "type": "object",
      "additionalProperties": false,
      "required": ["A10", "A11", "A12", "A13", "A14"],
      "properties": {
        "A10": { "$ref": "#/$defs/assertion" },
        "A11": { "$ref": "#/$defs/assertion" },
        "A12": { "$ref": "#/$defs/assertion" },
        "A13": { "$ref": "#/$defs/assertion" },
        "A14": { "$ref": "#/$defs/assertion" }
      }
    },
    "behaviourAndFairness": {
      "description": "21 §11.3 — A15 and A16.",
      "type": "object",
      "additionalProperties": false,
      "required": ["A15", "A16"],
      "properties": {
        "A15": { "$ref": "#/$defs/assertion" },
        "A16": { "$ref": "#/$defs/assertion" }
      }
    },
    "inherited": {
      "description": "21 §11.4 — the 23 requirements added by docs 24-28, unchanged and mandatory. All of E1 through E23 must be present; a missing one is a silently dropped requirement.",
      "type": "object",
      "additionalProperties": false,
      "required": ["E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8", "E9", "E10", "E11", "E12", "E13", "E14", "E15", "E16", "E17", "E18", "E19", "E20", "E21", "E22", "E23"],
      "patternProperties": { "^E([1-9]|1[0-9]|2[0-3])$": { "$ref": "#/$defs/assertion" } }
    }
  }
}
