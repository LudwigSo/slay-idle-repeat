{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slayidlerepeat.local/schema/inventory.schema.json",
  "title": "content/inventory/inventory.json",
  "description": "S16 — the loc keys the Gear screen renders. What is fixed here is that the screen heads the stock, captions the bag's occupancy and the overflow band, names the six slots and the hero's power, offers the sort orderings, marks the item worn in a slot and the locked and held ones, offers equip, unequip, lock, enhance, merge and salvage with a confirmation on the two destructive ones, carries one sentence per reason a control is not live, and one status line per state the read and a submission can be in. Every value is a loc key, so the content build resolves it against every locale file: a key this document names but a locale does not carry fails the build, and a locale string this document stops naming fails it as an orphan. additionalProperties is false on every object, so the absences are enforced rather than merely observed. 🔒 There is no member for reforge or retune, because both commands are deferred and a caption offering one would be a control that cannot succeed. 🔒 There is no member for buying bag space: 08 §5's errata makes capacity a flat 1000 and the ruling that set it declined to add EXPAND_INVENTORY to 14 §2.3's vocabulary, so nothing can move the ceiling and nothing may offer to. And no member carries a MAGNITUDE — every figure is read at render time and drawn beside these captions; a line that needs one carries a runtime parameter in braces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "_doc",
    "name",
    "label",
    "sort",
    "badge",
    "action",
    "block",
    "status",
    "slot",
    "family",
    "stat"
  ],
  "$defs": {
    "locKey": {
      "description": "loc.<domain>.<id>.<field>, lowercase, dot-separated, snake_case segments — the same shape schema/loc.schema.json governs the locale files by.",
      "type": "string",
      "pattern": "^loc(\\.[a-z0-9_]+)+$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_doc": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "description": "The screen's own heading.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/locKey"
        }
      }
    },
    "label": {
      "description": "🔒 Captions only. `capacity` is the words the bag's occupancy is drawn BESIDE; `heroPower` and `power` caption figures the rules compute; `setPieces`, `salvageReturns` and `selectedCount` carry runtime parameters the presenter fills. `held` heads the overflow band, which exists because a drop arriving at a full stock is held rather than refused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity",
        "held",
        "power",
        "sort",
        "heroPower",
        "emptySlot",
        "affixes",
        "set",
        "setPieces",
        "quality",
        "chapterOrigin",
        "enhanceCost",
        "enhanceOdds",
        "enhanceMaxed",
        "mergeKeeper",
        "mergeInputs",
        "mergeResult",
        "mergeCost",
        "mergeDust",
        "salvageReturns",
        "selectedCount",
        "quickPick"
      ],
