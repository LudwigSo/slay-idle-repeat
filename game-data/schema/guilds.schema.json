{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slayidlerepeat.local/schema/guilds.schema.json",
  "title": "guilds.json",
  "description": "27 §2-6 — quest targets, boss HP, perk values. 27 §5: all guild perks are non-combat by locked rule R1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "_doc", "_status", "structure", "quests", "guildChest", "boss", "level", "perks", "communication"],
  "properties": {
    "$schema": { "type": "string" },
    "_doc": { "type": "string", "minLength": 1 },
    "_status": { "enum": ["transcribed", "partial", "skeleton"] },
    "structure": {
      "description": "27 §2 — the social graph is deliberately 30 people wide. 27 §2.1: the 24-hour join cooldown exists so nobody joins thirty guilds a month and contributes to none.",
      "type": "object",
      "additionalProperties": false,
      "required": ["baseMemberCap", "maxMemberCap", "unlockLegendLevel", "creationCostCrowns", "joinPolicies", "nameMaxChars", "tagChars", "descriptionMaxChars", "descriptionPhraseCount", "descriptionPhrasesPerGuild", "leaderCount", "maxOfficers", "joinCooldownHours", "inactivityFlagDays", "inactivityRemovalDays", "leaderInactivityDemotionDays"],
      "properties": {
        "baseMemberCap": { "type": "integer", "exclusiveMinimum": 0 },
        "maxMemberCap": { "type": "integer", "exclusiveMinimum": 0 },
        "unlockLegendLevel": { "type": "integer", "minimum": 1, "maximum": 200 },
        "creationCostCrowns": { "type": "integer", "minimum": 0 },
        "joinPolicies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["OPEN", "REQUEST", "INVITE_ONLY"] } },
        "nameMaxChars": { "type": "integer", "exclusiveMinimum": 0 },
        "tagChars": { "type": "integer", "exclusiveMinimum": 0 },
        "descriptionMaxChars": { "type": "integer", "exclusiveMinimum": 0 },
        "descriptionPhraseCount": { "type": "integer", "exclusiveMinimum": 0 },
        "descriptionPhrasesPerGuild": { "type": "integer", "exclusiveMinimum": 0 },
        "leaderCount": { "const": 1 },
        "maxOfficers": { "type": "integer", "minimum": 0 },
        "joinCooldownHours": { "type": "number", "minimum": 0 },
        "inactivityFlagDays": { "type": "integer", "exclusiveMinimum": 0 },
        "inactivityRemovalDays": { "type": "integer", "exclusiveMinimum": 0 },
        "leaderInactivityDemotionDays": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "quests": {
      "description": "27 §3, §3.1 — 3 drawn per day from a pool of 15. At least one of the three must be satisfiable by ordinary chapter runs alone, so a runs-only player can always contribute.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "perDay", "drawUtc", "activeMemberWindowDays", "targetsAuthoredForActiveMembers", "targetScaling", "memberContributionCapShare", "streakDays", "runsOnlySatisfiable", "pool"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "perDay": { "type": "integer", "exclusiveMinimum": 0 },
        "drawUtc": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "activeMemberWindowDays": { "type": "integer", "exclusiveMinimum": 0 },
        "targetsAuthoredForActiveMembers": { "type": "integer", "exclusiveMinimum": 0 },
        "targetScaling": { "enum": ["LINEAR_IN_ACTIVE_MEMBERS"] },
        "memberContributionCapShare": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "streakDays": { "type": "integer", "exclusiveMinimum": 0 },
        "runsOnlySatisfiable": {
          "description": "27 §3.1 — the subset reachable by chapter runs alone. Every id here must exist in pool.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^GQ_[A-Z0-9_]+$" }
        },
        "pool": {
          "description": "27 §3.1 — exactly 15 authored guild quests. Targets are for the authored active-member count and scale linearly with the actual count.",
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "displayName", "targetAt30Actives", "gatedOn"],
            "properties": {
              "id": { "type": "string", "pattern": "^GQ_[A-Z0-9_]+$" },
              "displayName": { "type": "string", "pattern": "^loc(\\.[a-z0-9_]+)+$" },
              "targetAt30Actives": { "type": "integer", "exclusiveMinimum": 0 },
              "gatedOn": { "type": ["string", "null"], "enum": ["PVP", "DUNGEONS", null] }
            }
          }
        }
      }
    },
    "guildChest": {
      "description": "27 §3 — source class CHEST_NONE; 24 does not apply to it. No gear, no eggs, no crates, no Soul Shards, no pity progress. Amounts and scaling are not authored in the design docs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "sourceClass", "currencies", "amounts", "scaling", "streakBonusChestContents"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "sourceClass": { "const": "CHEST_NONE" },
        "currencies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["CROWNS", "ENHANCE_STONES", "BEAST_FEED", "MERGE_DUST"] } },
        "amounts": { "type": ["object", "null"] },
        "scaling": { "type": ["object", "string", "null"] },
        "streakBonusChestContents": { "type": ["object", "null"] }
      }
    },
    "boss": {
      "description": "27 §4 — one boss per week. 3 attempts per member per week, free, with no ad placement, no Plus grant and no purchase. GuildBossHp = baseHp * activeMembers * difficultyTierMultiplier; neither constant is authored in the design docs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "cadence", "weekStartUtc", "bossPool", "baseHp", "difficultyTiers", "difficultyTierMultiplier", "difficultyTierUnlockedBy", "attemptsPerMemberPerWeek", "adAttemptsAvailable", "energyCost", "universalEnrageRemoved", "simulatedTimeCapSeconds", "leaderboardTopN", "globalGuildLadder", "rewardBrackets"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "cadence": { "enum": ["WEEKLY"] },
        "weekStartUtc": { "type": "string", "minLength": 1 },
        "bossPool": { "type": "string", "minLength": 1 },
        "baseHp": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "difficultyTiers": { "type": "integer", "exclusiveMinimum": 0 },
        "difficultyTierMultiplier": { "type": ["array", "null"], "items": { "type": "number", "exclusiveMinimum": 0 } },
        "difficultyTierUnlockedBy": { "type": "string", "minLength": 1 },
        "attemptsPerMemberPerWeek": { "type": "integer", "exclusiveMinimum": 0 },
        "adAttemptsAvailable": {
          "description": "27 §4 — locked: no ad placement, no Plus grant, no purchase. Must be false.",
          "const": false
        },
        "energyCost": { "const": 0 },
        "universalEnrageRemoved": { "type": "boolean" },
        "simulatedTimeCapSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "leaderboardTopN": { "type": "integer", "exclusiveMinimum": 0 },
        "globalGuildLadder": { "type": "boolean" },
        "rewardBrackets": { "type": ["array", "null"] }
      }
    },
    "level": {
      "description": "27 §5 — guild levels 1..20. Guild XP comes from completed quests and boss damage, never from currency spent. The per-level ladders are not authored in the design docs, only their endpoints.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "min", "max", "xpPerQuestCompletion", "xpPerBossDamage", "memberCapLadder", "officerSlotLadder", "bossTierAccessLadder"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "xpPerQuestCompletion": { "type": ["number", "null"], "minimum": 0 },
        "xpPerBossDamage": { "type": ["number", "null"], "minimum": 0 },
        "memberCapLadder": { "type": ["array", "null"], "items": { "type": "integer", "exclusiveMinimum": 0 } },
        "officerSlotLadder": { "type": ["array", "null"], "items": { "type": "integer", "minimum": 0 } },
        "bossTierAccessLadder": { "type": ["array", "null"], "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "perks": {
      "description": "27 §5 — the complete list; there are no others. Every perk must be non-combat: if a guild perk ever showed up in PlayerPower, locked rule R1 has been violated and an architecture test should already have failed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "allNonCombat", "list"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "allNonCombat": { "const": true },
        "list": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "displayName", "effect", "maxValueAtLevel20", "perLevelRamp"],
            "properties": {
              "id": { "type": ["string", "null"], "pattern": "^GP_[A-Z0-9_]+$" },
              "displayName": { "type": "string", "pattern": "^loc(\\.[a-z0-9_]+)+$" },
              "effect": {
                "description": "27 §5 / 29 §3 — must be an income or throughput effect, never a combat stat.",
                "enum": ["CROWNS_GAIN", "BEAST_FEED_GAIN", "ENHANCE_STONES_GAIN", "ENERGY_REGEN_RATE", "MERGE_DUST_GAIN"]
              },
              "maxValueAtLevel20": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "perLevelRamp": { "type": ["array", "null"], "items": { "type": "number", "minimum": 0 } }
            }
          }
        }
      }
    },
    "communication": {
      "description": "27 §6 — the phrase board is a fixed-vocabulary surface, not free text. The phrase strings themselves are localisation keys and live in loc/, not here.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "phraseCount", "phraseCategories", "phrasesPerCategory", "postsPerMemberPerDay", "boardRetainedPosts", "boardTtlDays", "logRetentionDays", "leaderRoleActionsPerDay"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "phraseCount": { "type": "integer", "exclusiveMinimum": 0 },
        "phraseCategories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
        "phrasesPerCategory": { "type": "integer", "exclusiveMinimum": 0 },
        "postsPerMemberPerDay": { "type": "integer", "minimum": 0 },
        "boardRetainedPosts": { "type": "integer", "exclusiveMinimum": 0 },
        "boardTtlDays": { "type": "integer", "exclusiveMinimum": 0 },
        "logRetentionDays": { "type": "integer", "exclusiveMinimum": 0 },
        "leaderRoleActionsPerDay": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
