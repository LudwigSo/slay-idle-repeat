{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slayidlerepeat.local/schema/forge.schema.json",
  "title": "forge.json",
  "description": "08 §4.1-4.3 (merge, enhance, salvage) and 24 §6.1-6.2 (reforge, retune). The five Forge operations, all free of real money.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "_doc", "_status", "merge", "enhance", "salvage", "reforge", "retune", "inventory"],
  "$defs": {
    "rarity": { "enum": ["C", "B", "A", "S", "SS"] },
    "rarityCostMap": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": { "^(C|B|A|S|SS)$": { "type": ["integer", "null"], "minimum": 0 } }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "_doc": { "type": "string", "minLength": 1 },
    "_status": { "enum": ["transcribed", "partial", "skeleton"] },
    "merge": {
      "description": "08 §4.1 — 3 x [same item, same rarity, same enhancement level] -> 1 x [same item, next rarity]. 21 §12: MergeCrownCost is likely the real mid-game wall and is one of the highest-suspicion numbers in the economy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "inputCount", "dustSubstituteMaxInputs", "availableFromRarity", "availableToRarity", "outputQualityRule", "outputChapterOriginRule", "outputKeepsSharedEnhanceLevel", "outputRerollsAffixes", "dustSubstituteCost", "crownCostByOutputRarity"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "inputCount": { "type": "integer", "minimum": 2 },
        "dustSubstituteMaxInputs": { "type": "integer", "minimum": 0 },
        "availableFromRarity": { "$ref": "#/$defs/rarity" },
        "availableToRarity": { "$ref": "#/$defs/rarity" },
        "outputQualityRule": {
          "description": "08 §4.1 — the output takes the highest q of its inputs; a Merge-Dust-substituted slot does not count.",
          "const": "MAX_OF_REAL_INPUTS"
        },
        "outputChapterOriginRule": {
          "description": "08 §4.1 — without the max rule, ItemPower's per-chapter doubling lets identical-looking merges legally differ by up to x16.",
          "const": "MAX_OF_REAL_INPUTS"
        },
        "outputKeepsSharedEnhanceLevel": { "type": "boolean" },
        "outputRerollsAffixes": { "type": "boolean" },
        "dustSubstituteCost": {
          "description": "08 §4.1 — keyed on input rarity. SS is null: SS is the top rarity, so nothing merges out of it.",
          "$ref": "#/$defs/rarityCostMap"
        },
        "crownCostByOutputRarity": {
          "description": "08 §4.1 — keyed on OUTPUT rarity, so there is deliberately no C entry.",
          "$ref": "#/$defs/rarityCostMap"
        }
      }
    },
    "enhance": {
      "description": "08 §4.2 — every item can be enhanced from +0 to +15. Enhancement never destroys or downgrades an item. Failure mercy is owned by 24 §4.6 and lives in luck.json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "minLevel", "maxLevel", "statBonusPerLevel", "totalMultiplierAtMax", "neverDestroysOrDowngrades", "failureLosesLevel", "failureConsumesStones", "stoneCostPerLevel", "successRateBands", "perLevelSuccessRate", "plusLuckyChargesPerDay", "plusLuckyPercentagePoints", "plusLuckyChargesAccumulate"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "minLevel": { "type": "integer", "minimum": 0 },
        "maxLevel": { "type": "integer", "minimum": 1 },
        "statBonusPerLevel": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "totalMultiplierAtMax": { "type": "number", "exclusiveMinimum": 1 },
        "neverDestroysOrDowngrades": { "const": true },
        "failureLosesLevel": { "const": false },
        "failureConsumesStones": { "type": "boolean" },
        "stoneCostPerLevel": {
          "description": "08 §4.2 — one cost per level from +1 to maxLevel, strictly ascending. 25 §7 E9: the +11 to +15 costs must be re-derived by the simulator, not tuned by hand.",
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": { "type": "integer", "exclusiveMinimum": 0 }
        },
        "successRateBands": {
          "description": "08 §4.2 — the design docs give band endpoints only ('85% -> 65%', '50% -> 25%') and never state the interpolation.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fromLevel", "toLevel", "startRate", "endRate"],
            "properties": {
              "fromLevel": { "type": "integer", "minimum": 1 },
              "toLevel": { "type": "integer", "minimum": 1 },
              "startRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "endRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
            }
          }
        },
        "perLevelSuccessRate": {
          "description": "The per-level expansion of successRateBands. null because the interpolation between band endpoints is not stated anywhere in the design docs and must not be guessed.",
          "type": ["array", "null"],
          "minItems": 15,
          "maxItems": 15,
          "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        },
        "plusLuckyChargesPerDay": { "type": "integer", "minimum": 0 },
        "plusLuckyPercentagePoints": { "type": "number", "minimum": 0, "maximum": 100 },
        "plusLuckyChargesAccumulate": { "const": false }
      }
    },
    "salvage": {
      "description": "08 §4.3 — DustValue(rarity, enhanceLevel) = baseDust(rarity) * (1 + dustPerEnhanceLevel * enhanceLevel).",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "baseDustByRarity", "dustPerEnhanceLevel", "stoneRefundShare"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "baseDustByRarity": { "$ref": "#/$defs/rarityCostMap" },
        "dustPerEnhanceLevel": { "type": "number", "minimum": 0 },
        "stoneRefundShare": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "reforge": {
      "description": "24 §6.1 — the forge-screen view of the reforge costs owned by luck.json. The two must agree; a mismatch is a bug the validator should catch.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "currency", "costByRarity"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "currency": { "enum": ["MERGE_DUST", "ENHANCE_STONES", "CROWNS", "SOUL_SHARDS", "BEAST_FEED", "HONOR"] },
        "costByRarity": { "$ref": "#/$defs/rarityCostMap" }
      }
    },
    "retune": {
      "description": "24 §6.2 — the forge-screen view of the retune costs owned by luck.json. The two must agree.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "currency", "costByRarity", "lockCostMultiplier", "wishlistMaxAffixes", "wishlistMissWeightBonus"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "currency": { "enum": ["MERGE_DUST", "ENHANCE_STONES", "CROWNS", "SOUL_SHARDS", "BEAST_FEED", "HONOR"] },
        "costByRarity": { "$ref": "#/$defs/rarityCostMap" },
        "lockCostMultiplier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["1", "2", "3"],
          "patternProperties": { "^[123]$": { "type": "number", "minimum": 1 } }
        },
        "wishlistMaxAffixes": { "type": "integer", "minimum": 1, "maximum": 4 },
        "wishlistMissWeightBonus": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "inventory": {
      "description": "08 §5 — capacity 120 to 320 in steps of 20, bought with Crowns (earned currency only). The design never sells inventory space for money.",
      "type": "object",
      "additionalProperties": false,
      "required": ["_doc", "baseCapacity", "expansionStep", "maxCapacity"],
      "properties": {
        "_doc": { "type": "string", "minLength": 1 },
        "baseCapacity": { "type": "integer", "exclusiveMinimum": 0 },
        "expansionStep": { "type": "integer", "exclusiveMinimum": 0 },
        "maxCapacity": {
          "description": "08 §5 / 10 §4 — the ceiling the purchase ladder reaches: baseCapacity + inventoryExpansionMaxPurchases * inventoryExpansionSlotsPerPurchase from currencies.json. A derived fact, not an independent number; DeclaredRules checks the three agree.",
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
