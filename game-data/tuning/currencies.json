  "chapterScalars": {
    "_doc": "03 §7a — two chapter scalars. G(c) = goldGrowth^(c-1) matches XP and shop-price growth exactly; M(c) = metaGrowth^(c-1) is deliberately slower than the x2/chapter power curve so material income never outruns the merge bottleneck. adBundleScalar is the linear 1 + 0.35*highestChapterCleared form used by ad bundles (12 §5), minigames (03 §6.1), the login calendar (19 Part G) and the shop's scaled material offers.",
    "goldGrowth": 1.55,
    "metaGrowth": 1.35,
    "adBundleScalar": 0.35,
    "roundingMode": "NEAREST_INTEGER"
  },
  "inRunIncome": {
